<!DOCTYPE html>
<html lang="zh-Hant">
<head>
  <meta charset="UTF-8">
  <title>放射藥物預約系統</title>
  <!-- FullCalendar CDN -->
  <script src='https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.js'></script>
  <!-- Supabase CDN -->
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <!-- SweetAlert2 漂亮彈窗 CDN -->
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
 
  <!-- EmailJS SDK 載入與初始化 -->
  <script src="https://cdn.jsdelivr.net/npm/@emailjs/browser@3/dist/email.min.js"></script>
  <script>
    emailjs.init('uWIpVaBRjMqSKLEXZ'); // EmailJS Public Key
  </script>

  <style>
    body { font-family: sans-serif; margin: 20px; }
    #calendar { height: 750px; width: 95%; margin: 10px auto; border: 1px solid #ccc; }
    .tips { text-align: center; color: #666; font-size: 14px; margin-bottom: 10px; }
    .controls { text-align: center; margin-bottom: 15px; }
    .btn-global-limit {
      background-color: #6c757d;
      color: white;
      border: none;
      padding: 8px 15px;
      border-radius: 4px;
      cursor: pointer;
      font-weight: bold;
      margin: 0 5px;
    }
    .btn-global-limit:hover { background-color: #5a6268; }
  </style>
</head>
<body>

  <h2 style="text-align: center;">放射藥物中心預約日曆</h2>
  
  <div id="announcement" style="
    background-color: #fff3cd; 
    border: 1px solid #ffeeba; 
    color: #856404; 
    padding: 15px; 
    margin: 10px auto; 
    width: 95%; 
    border-radius: 5px; 
    text-align: center; 
    font-weight: bold; 
    cursor: pointer;
  " title="點擊上方公告 (僅管理員可修改)">載入公告中...</div>

  <div class="controls">
    <button id="setGlobalLimitBtn" class="btn-global-limit" style="display: none;">⚙️ 設定某日起之預設每日上限</button>
  </div>

  <div class="tips">提示：請點擊或拖曳選取日期進行操作。星期日為休息日，不顯示 Available。C-11 僅限週一、三、五；F-18 PSMA 僅限週四。有額度的日期會顯示 [Available C-11] 或 [Available F-18 PSMA]，點擊即可預約。當日總預約達上限後，所有中心都不再顯示 Available。一般使用者僅能預約未來一個月內的日期。</div>
  <div id='calendar'></div>

  <script>
    const SUPABASE_URL = 'https://xmbxdhlczolshrdxbwnm.supabase.co';
    const SUPABASE_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InhtYnhkaGxjem9sc2hyZHhid25tIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODY3MDI4NDQsImV4cCI6MjEwMjI3ODg0NH0.T9jdhxDoeHLCJePpV--aexc69gGSJj3BeItLNcZMzK8';
    
    const supabaseClient = window.supabase.createClient(SUPABASE_URL, SUPABASE_KEY);
    let currentUser = null;
    let calendar = null;
    let pmRanges = []; // 存放 PM 區間
    let allowedWeekdays = [1, 3, 4, 5]; // 固定開放：週一、三、四、五（依藥物限制）

    function getStatusColor(status) {
      switch ((status || '').toLowerCase()) {
        case 'pending': return '#f0ad4e';
        case 'confirmed': return '#5cb85c';
        case 'pm': return '#d9534f';
        default: return '#333333';
      }
    }

    // 漂亮登入視窗函數 (SweetAlert2)
    async function performLogin() {
      let deptData = null;

      while (!deptData) {
        const { value: formValues } = await Swal.fire({
          title: '請登入系統',
          html:
            '<input id="swal-input-dept" class="swal2-input" placeholder="部門代號 (如 UNE, AH)">' +
            '<input id="swal-input-pass" type="password" class="swal2-input" placeholder="密碼">',
          focusConfirm: false,
          allowOutsideClick: false,
          preConfirm: () => {
            return [
              document.getElementById('swal-input-dept').value,
              document.getElementById('swal-input-pass').value
            ]
          }
        });

        if (!formValues) return null;
        const [deptCode, password] = formValues;
        if (!deptCode || !password) {
          Swal.showValidationMessage('請輸入代號與密碼');
          continue;
        }

        // 驗證邏輯
        const { data, error } = await supabaseClient
          .from('departments')
          .select('*')
          .eq('dept_code', deptCode.toUpperCase())
          .eq('password', password)
          .single();

        if (error || !data) {
          await Swal.fire({ icon: 'error', title: '登入失敗', text: '代號或密碼錯誤，請重新輸入。' });
        } else {
          deptData = data;
          await Swal.fire({ icon: 'success', title: `歡迎 ${deptData.dept_code}`, timer: 1500, showConfirmButton: false });
        }
      }
      return deptData;
    }

    document.addEventListener('DOMContentLoaded', async function() {
      // 1. 執行登入程序
      currentUser = await performLogin();
      if (!currentUser) return;

      const isAdmin = currentUser.is_admin || currentUser.dept_code === 'UNE';

      // 2. 如果是管理員 / UNE，顯示管理按鈕
      if (isAdmin) {
        document.getElementById('setGlobalLimitBtn').style.display = 'inline-block';
      }

      // 綁定動態預設上限按鈕事件
      document.getElementById('setGlobalLimitBtn').addEventListener('click', async () => {
        let startDateInput = prompt("請輸入新上限的【生效起始日期】(格式 YYYY-MM-DD)：", new Date().toISOString().split('T')[0]);
        if (!startDateInput) return;

        const parts = startDateInput.trim().split('-');
        if (parts.length !== 3) return alert("日期格式錯誤，請使用 YYYY-MM-DD 格式！");
        const formattedStartDate = `${parts[0]}-${String(parts[1]).padStart(2, '0')}-${String(parts[2]).padStart(2, '0')}`;

        let inputLimit = prompt(`請輸入從 ${formattedStartDate} 開始的新預設每日 Booking 上限：`, "2");
        if (inputLimit === null) return;
        let limitVal = parseInt(inputLimit);
        if (isNaN(limitVal) || limitVal < 0) return alert("請輸入有效的數字！");

        const { error: delError } = await supabaseClient
          .from('default_limits')
          .delete()
          .gte('effective_date', formattedStartDate);

        if (delError) {
          return alert("更新失敗（刪除舊規則時出錯）：" + delError.message);
        }

        const { error: insError } = await supabaseClient
          .from('default_limits')
          .insert([{
            effective_date: formattedStartDate,
            max_limit: limitVal
          }]);

        if (insError) {
          alert("更新失敗：" + insError.message);
        } else {
          alert(`已成功設定：自 ${formattedStartDate} 起，預設每日上限改為 ${limitVal} 個！`);
          if (calendar) calendar.refetchEvents();
        }
      });

      // 3. 載入 PM 區間
      async function loadPmRanges() {
        const { data, error } = await supabaseClient.from('pm_events').select('*');
        if (!error && data) {
          pmRanges = data;
          if (calendar) calendar.refetchEvents();
        }
      }
      loadPmRanges();

      // 4. 公告欄處理
      const annDiv = document.getElementById('announcement');
      async function loadAnnouncement() {
        const { data, error } = await supabaseClient.from('announcements').select('message').eq('id', 1).single();
        if (!error && data) annDiv.innerText = data.message;
      }

      annDiv.addEventListener('click', async () => {
        if (!isAdmin) return;
        const newMsg = prompt("【管理員】請輸入新的系統公告內容：", annDiv.innerText);
        if (newMsg !== null) {
          const { error } = await supabaseClient.from('announcements').update({ message: newMsg }).eq('id', 1);
          if (error) alert("更新失敗：" + error.message);
          else { annDiv.innerText = newMsg; alert("公告已更新！"); }
        }
      });
      loadAnnouncement();

      // 5. 初始化日曆
      var calendarEl = document.getElementById('calendar');
      calendar = new FullCalendar.Calendar(calendarEl, {
        initialView: 'dayGridMonth',
        headerToolbar: { left: 'prev,next today', center: 'title', right: '' },
        displayEventTime: false,
        editable: true,
        selectable: true,

        events: async function(fetchInfo, successCallback, failureCallback) {
          const { data: bookings, error } = await supabaseClient
            .from('bookings')
            .select('*, centers(center_code), products(product_name)')
            .neq('status', 'Cancelled');
          if (error) return failureCallback(error);

          let events = [];
          const bookingCountByDate = {};

          bookings.forEach(b => {
            const dateStr = b.injection_time ? String(b.injection_time).substring(0, 10) : '';
            if (dateStr) {
              bookingCountByDate[dateStr] = (bookingCountByDate[dateStr] || 0) + 1;
            }

            const canSee = isAdmin || (b.centers && b.centers.center_code === currentUser.dept_code);
            if (!canSee) return;

            events.push({
              id: b.booking_id,
              title: `[ ${b.centers ? b.centers.center_code : 'N/A'} ] ${b.products ? b.products.product_name : 'N/A'}`,
              start: b.injection_time,
              backgroundColor: getStatusColor(b.status),
              extendedProps: { 
                centerCode: b.centers ? b.centers.center_code : '',
                productName: b.products ? b.products.product_name : ''
              }
            });
          });

          pmRanges.forEach(pm => {
            let nextDayStr = pm.end_date;
            if (pm.end_date) {
              let d = new Date(pm.end_date);
              d.setDate(d.getDate() + 1);
              nextDayStr = d.toISOString().split('T')[0];
            }

            events.push({
              id: 'pm_' + pm.id,
              title: `🛠️ PM: ${pm.description || '系統維護'}`,
              start: pm.start_date,
              end: nextDayStr,
              backgroundColor: '#d9534f',
              allDay: true,
              extendedProps: { isPmRange: true, pmId: pm.id }
            });
          });

          const viewStart = fetchInfo.startStr.split('T')[0];
          const viewEnd = fetchInfo.endStr.split('T')[0];

          const { data: allDailyLimits } = await supabaseClient
            .from('daily_limits')
            .select('date, max_limit')
            .gte('date', viewStart)
            .lte('date', viewEnd);

          const dailyLimitMap = {};
          if (allDailyLimits) {
            allDailyLimits.forEach(row => {
              const d = String(row.date).substring(0, 10);
              dailyLimitMap[d] = Number(row.max_limit);
            });
          }

          const { data: allDefaultRules } = await supabaseClient
            .from('default_limits')
            .select('effective_date, max_limit')
            .order('effective_date', { ascending: false });

          function getDailyLimitForDate(dateStr) {
            if (dailyLimitMap[dateStr] !== undefined) return dailyLimitMap[dateStr];
            if (allDefaultRules && allDefaultRules.length > 0) {
              for (const rule of allDefaultRules) {
                const eff = String(rule.effective_date).substring(0, 10);
                if (eff <= dateStr) return Number(rule.max_limit);
              }
            }
            return 2;
          }

          const productDays = {
            C11:  { days: [1, 3, 5], title: '[Available C-11]',     color: '#5cb85c', drugValue: '1' },
            PSMA: { days: [4],       title: '[Available F-18 PSMA]', color: '#5bc0de', drugValue: '2' }
          };

          let cursor = new Date(viewStart + 'T00:00:00');
          const endCursor = new Date(viewEnd + 'T00:00:00');
          const today = new Date();
          today.setHours(0, 0, 0, 0);
          const maxBookableDate = new Date(today);
          maxBookableDate.setMonth(maxBookableDate.getMonth() + 1);

          while (cursor < endCursor) {
            const year = cursor.getFullYear();
            const month = String(cursor.getMonth() + 1).padStart(2, '0');
            const day = String(cursor.getDate()).padStart(2, '0');
            const dateStr = `${year}-${month}-${day}`;
            const dayOfWeek = cursor.getDay();

            if (dayOfWeek === 0) {
              cursor.setDate(cursor.getDate() + 1);
              continue;
            }

            const isBlocked = pmRanges.some(pm => dateStr >= pm.start_date && dateStr <= pm.end_date);
            if (isBlocked) {
              cursor.setDate(cursor.getDate() + 1);
              continue;
            }

            if (!isAdmin) {
              if (!allowedWeekdays.includes(dayOfWeek)) {
                cursor.setDate(cursor.getDate() + 1);
                continue;
              }
              if (cursor > maxBookableDate) {
                cursor.setDate(cursor.getDate() + 1);
                continue;
              }
            }

            const dailyLimit = getDailyLimitForDate(dateStr);
            const currentCount = bookingCountByDate[dateStr] || 0;

            if (currentCount >= dailyLimit) {
              cursor.setDate(cursor.getDate() + 1);
              continue;
            }

            for (const [key, prod] of Object.entries(productDays)) {
              if (prod.days.includes(dayOfWeek)) {
                events.push({
                  id: 'available_' + key + '_' + dateStr,
                  title: prod.title,
                  start: dateStr,
                  allDay: true,
                  backgroundColor: prod.color,
                  borderColor: prod.color,
                  textColor: '#fff',
                  extendedProps: {
                    isAvailable: true,
                    availableDate: dateStr,
                    preferredDrug: prod.drugValue
                  }
                });
              }
            }

            cursor.setDate(cursor.getDate() + 1);
          }

          successCallback(events);
        },

        eventClick: async function(info) {
          if (info.event.extendedProps.isAvailable) {
            const dateStr = info.event.extendedProps.availableDate;
            window._preferredDrug = info.event.extendedProps.preferredDrug || null;

            const startDate = new Date(dateStr + 'T00:00:00');
            const endDate = new Date(startDate.getTime() + 86400000);
            calendar.select(startDate, endDate);
            return;
          }

          if (!isAdmin) {
            if (info.event.extendedProps.isPmRange) return;
            if (info.event.extendedProps.centerCode === currentUser.dept_code) {
              if (confirm("確定取消預約?")) {
                const { error } = await supabaseClient.from('bookings').update({ status: 'Cancelled' }).eq('booking_id', info.event.id);
                if (error) {
                  alert("取消失敗：" + error.message);
                } else {
                  const cancelDate = info.event.startStr.split('T')[0];
                  const cancelProduct = info.event.extendedProps.productName || '';

                  // 發送取消通知 Email
                  emailjs.send('service_d9vspu1', 'template_zn6pbfl', {
                    center_code: currentUser.dept_code,
                    booking_date: cancelDate,
                    product_name: cancelProduct
                  }).catch(err => console.error("取消 EmailJS 發送失敗:", err));

                  await Swal.fire({
                    icon: 'success',
                    title: '已取消預約',
                    text: `已成功取消 ${cancelDate} 的預約，並寄出通知信。`,
                    timer: 2000,
                    showConfirmButton: false
                  });

                  calendar.refetchEvents();
                }
              }
            } else {
              alert("權限不足");
            }
            return;
          }

          if (info.event.extendedProps.isPmRange) {
            if (confirm("是否要刪除此 PM 維護區間？")) {
              const { error } = await supabaseClient.from('pm_events').delete().eq('id', info.event.extendedProps.pmId);
              if (error) alert("刪除失敗：" + error.message);
              else { loadPmRanges(); alert("PM 維護區間已刪除"); }
            }
            return;
          }

          let newStatusInput = prompt("輸入狀態: 1:Pending, 2:Confirmed, 3:Cancelled");
          if (!newStatusInput) return;

          const statusMap = { '1': 'Pending', '2': 'Confirmed', '3': 'Cancelled' };
          const finalStatus = statusMap[newStatusInput];
          if (!finalStatus) return alert("無效的狀態代號");

          let staffName = prompt("請輸入經手 Staff 姓名：");
          if (staffName === null) return;

          const { error } = await supabaseClient.from('bookings').update({ 
              status: finalStatus,
              staff_name: staffName.trim()
          }).eq('booking_id', info.event.id);

          if (error) alert("更新失敗：" + error.message);
          else { calendar.refetchEvents(); alert("更新成功！"); }
        },

        select: async function(info) {
          const startDateStr = info.startStr.split('T')[0];
          
          const endDateObj = new Date(info.end);
          endDateObj.setDate(endDateObj.getDate() - 1);
          const calculatedEndDateStr = endDateObj.toISOString().split('T')[0];

          let actionChoice = "1";

          if (isAdmin) {
            let actionPrompt = "請選擇您想執行的動作：\n1. BOOKING (新增預約)\n2. PM (設定維護期間)";
            actionChoice = prompt(actionPrompt, "1");
            if (!actionChoice) return;
          }

          if (actionChoice === '2') {
            if (!isAdmin) return alert("權限不足：只有 UNE 管理員可以設定 PM！");
            let endDateStr = prompt("請輸入 PM 結束日期 (格式 YYYY-MM-DD)：", calculatedEndDateStr);
            if (!endDateStr) return;
            let pmDesc = prompt("請輸入 PM 維護說明內容：", "儀器維護");

            const { error } = await supabaseClient.from('pm_events').insert([{
              start_date: startDateStr,
              end_date: endDateStr,
              description: pmDesc
            }]);

            if (error) alert("新增 PM 失敗：" + error.message);
            else { alert("PM 維護期間設定成功！"); loadPmRanges(); }
            return;
          }

          if (actionChoice === '1') {
            const dayOfWeek = info.start.getDay();
            const selectedDate = new Date(startDateStr + 'T00:00:00');

            if (!isAdmin) {
              const today = new Date();
              today.setHours(0, 0, 0, 0);
              const maxDate = new Date(today);
              maxDate.setMonth(maxDate.getMonth() + 1);

              if (selectedDate > maxDate) {
                return Swal.fire({
                  icon: 'warning',
                  title: '預約限制',
                  text: `一般使用者僅能預約未來一個月內的日期（最遠至 ${maxDate.toISOString().split('T')[0]}）！`
                });
              }

              if (dayOfWeek === 0) {
                return Swal.fire({ icon: 'warning', title: '休息日', text: '星期日為休息日，無法進行預約！' });
              }
              if (!allowedWeekdays.includes(dayOfWeek)) {
                const dayNames = ['日', '一', '二', '三', '四', '五', '六'];
                return Swal.fire({
                  icon: 'warning',
                  title: '預約限制',
                  text: `星期${dayNames[dayOfWeek]}未開放預約！目前僅開放特定星期進行預約。`
                });
              }
            }

const isBlocked = pmRanges.some(pm => startDateStr >= pm.start_date && startDateStr <= pm.end_date);
if (isBlocked && !isAdmin) {
  return Swal.fire({ icon: 'warning', title: '系統維護', text: '該日期位於系統維護 (PM) 期間，無法進行預約！' });
}

            let dailyLimit = 2;
            const { data: exactLimitData } = await supabaseClient
              .from('daily_limits')
              .select('max_limit')
              .eq('date', startDateStr)
              .maybeSingle();
            if (exactLimitData && exactLimitData.max_limit !== null && exactLimitData.max_limit !== undefined) {
              dailyLimit = Number(exactLimitData.max_limit);
            } else {
              const { data: ruleData, error: ruleErr } = await supabaseClient
                .from('default_limits')
                .select('max_limit, effective_date')
                .lte('effective_date', startDateStr)
                .order('effective_date', { ascending: false })
                .limit(1);

              if (!ruleErr && ruleData && ruleData.length > 0) {
                dailyLimit = Number(ruleData[0].max_limit);
              }
            }

            if (!isAdmin) {
              const { data: existingBookings, error: checkError } = await supabaseClient
                .from('bookings')
                .select('booking_id')
                .gte('injection_time', startDateStr + 'T00:00:00')
                .lte('injection_time', startDateStr + 'T23:59:59')
                .neq('status', 'Cancelled');

              if (!checkError && existingBookings && existingBookings.length >= dailyLimit) {
                return Swal.fire({
                  icon: 'warning',
                  title: '額度已滿',
                  text: `該日期 (${startDateStr}) 的總預約已達上限（當日最多 ${dailyLimit} 個），無法再新增！`
                });
              }
            }

            let targetCenterCode = currentUser.dept_code;
            if (isAdmin) {
              let inputCenter = prompt("您目前為管理員/UNE身份，請輸入要幫哪個 Center 代約的代號 (例如 AH):");
              if (!inputCenter) return;
              targetCenterCode = inputCenter.trim().toUpperCase();
            }

            const { data: center, error: centerErr } = await supabaseClient.from('centers').select('center_id').eq('center_code', targetCenterCode).single();
            if (centerErr || !center) {
              return Swal.fire({ icon: 'error', title: '錯誤', text: `找不到代號為 "${targetCenterCode}" 的中心資料` });
            }

            if (currentUser.dept_code !== 'UNE') {
              const { data: centerExistingBookings, error: centerCheckErr } = await supabaseClient
                .from('bookings')
                .select('booking_id')
                .eq('center_id', center.center_id)
                .gte('injection_time', startDateStr + 'T00:00:00')
                .lte('injection_time', startDateStr + 'T23:59:59')
                .neq('status', 'Cancelled');

              if (!centerCheckErr && centerExistingBookings && centerExistingBookings.length > 0) {
                return Swal.fire({
                  icon: 'warning',
                  title: '預約限制',
                  text: `${targetCenterCode} 在該日期 (${startDateStr}) 已經有一個預約案子。每個中心每日限預約 1 個 Case（如需加約請聯絡 UNE 協助代約）！`
                });
              }
            }

            let p = window._preferredDrug || null;
            window._preferredDrug = null;

            if (!p) {
              const { value: selectedP } = await Swal.fire({
                title: '選擇藥物',
                html: `
                  <div style="text-align: left; margin: 15px 0;">
                    <label style="display: block; margin-bottom: 12px; cursor: pointer; font-size: 16px;">
                      <input type="radio" name="drug" value="1" style="transform: scale(1.3); margin-right: 10px;" checked>
                      C-11 Acetate
                    </label>
                    <label style="display: block; margin-bottom: 12px; cursor: pointer; font-size: 16px;">
                      <input type="radio" name="drug" value="2" style="transform: scale(1.3); margin-right: 10px;">
                      F-18 PSMA-1007
                    </label>
                  </div>
                `,
                focusConfirm: false,
                showCancelButton: true,
                confirmButtonText: '確認預約',
                cancelButtonText: '取消',
                preConfirm: () => {
                  const selected = document.querySelector('input[name="drug"]:checked');
                  if (!selected) {
                    Swal.showValidationMessage('請選擇一種藥物');
                    return false;
                  }
                  return selected.value;
                }
              });
              if (!selectedP) return;
              p = selectedP;
            }

            const prodName = p === '1' ? 'C-11 Acetate' : 'F-18 PSMA-1007';

            if (!isAdmin) {
              const productAllowedDays = {
                'C-11 Acetate': [1, 3, 5],
                'F-18 PSMA-1007': [4]
              };

              const allowedForThisProduct = productAllowedDays[prodName] || [];
              if (!allowedForThisProduct.includes(dayOfWeek)) {
                const dayNames = ['日', '一', '二', '三', '四', '五', '六'];
                return Swal.fire({
                  icon: 'warning',
                  title: '藥物限制',
                  text: `${prodName} 僅能預約星期${allowedForThisProduct.map(d => dayNames[d]).join('、')}，無法預約星期${dayNames[dayOfWeek]}！`
                });
              }
            }

            const { data: prod, error: prodErr } = await supabaseClient
              .from('products')
              .select('product_id')
              .ilike('product_name', `%${prodName}%`)
              .single();

            if (prodErr || !prod) {
              return Swal.fire({ icon: 'error', title: '錯誤', text: '找不到對應的藥物資料' });
            }
            
            const bookingDateTime = startDateStr + 'T11:00:00';

            const { error: insertErr } = await supabaseClient.from('bookings').insert([{ 
              center_id: center.center_id, 
              product_id: prod.product_id, 
              injection_time: bookingDateTime, 
              status: 'Pending' 
            }]);

            if (insertErr) {
              Swal.fire({ icon: 'error', title: '預約失敗', text: insertErr.message });
            } else {
              // 發送新增預約通知 Email
              emailjs.send('service_d9vspu1', 'template_sb572pq', {
                center_code: targetCenterCode,
                booking_date: startDateStr,
                product_name: prodName
              }).catch(err => console.error("新增 EmailJS 發送失敗:", err));

              await Swal.fire({
                icon: 'success',
                title: '預約成功',
                text: `已成功為 [${targetCenterCode}] 於 ${startDateStr} 11:00 建立預約！`,
                timer: 2000,
                showConfirmButton: false
              });
              calendar.refetchEvents();
            }
          }
        }
      });
      calendar.render();
    });
  </script>
</body>
</html>
